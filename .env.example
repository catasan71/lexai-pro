# Copiază acest fișier ca .env.local pentru development local
# NICIODATĂ nu comite .env.local pe GitHub!

# --- Anthropic (server-side, folosit de api/claude.js) ---
# Obții key-ul de pe: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXX

# --- Supabase (frontend, Auth + DB) ---
# Project Settings → API → Project URL & anon key
# Cheia anon e publică (sigură în frontend) — protecția vine din RLS.
VITE_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXX

# --- Supabase (server-side, folosit de api/claude.js pentru credit enforcement) ---
# Project Settings → API → service_role key (SECRET — NICIODATĂ în frontend!)
# Aceeași valoare ca VITE_SUPABASE_URL, fără prefixul VITE_.
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXX

# --- Revolut Merchant API (server-side, plăți) ---
REVOLUT_API_KEY=sk_XXXXXXXXXXXXXXXXXXXXXXXX
REVOLUT_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXX
REVOLUT_SANDBOX=true
APP_URL=https://lexai.pro

# --- Sentry (opțional — monitorizare erori; lasă necompletat pentru a dezactiva) ---
VITE_SENTRY_DSN=
SENTRY_DSN=
